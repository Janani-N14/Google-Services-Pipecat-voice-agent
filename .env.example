# ==============================================================================
# Voice Agent Environment Configuration
# ==============================================================================

# --- Groq Cloud API Settings (STT & LLM) ---
# Sign up and get free API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_LLM_MODEL=qwen/qwen3.8-27b
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_STT_LANGUAGE=en

# --- Sarvam AI Settings (Text to Speech) ---
# Sign up and get free API key from https://sarvam.ai / https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_VOICE=shubh
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TTS_PACE=1.0
SARVAM_TTS_TEMPERATURE=0.6
SARVAM_TTS_PREPROCESSING=true
SARVAM_TTS_STREAMING=true

# --- Google Workspace OAuth (Gmail & Google Calendar) ---
# Download client OAuth credentials JSON from Google Cloud Console
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json
